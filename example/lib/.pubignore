# Throwaway harnesses used to drive gestures and capture frames while
# investigating rendering and performance. They are committed so the
# measurements can be reproduced, but they are not part of the demo and have
# no business in the published archive.
#
# Scoped to this directory on purpose: a .pubignore REPLACES the .gitignore in
# the same directory, so putting this at the repo root silently pulled build/
# and .dart_tool/ into the archive and took it from 726 KB to 56 MB.
probe.dart
probe_perf.dart
probe_menu.dart
